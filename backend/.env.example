# Environment Settings
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://personalized-learning-frontend.onrender.com

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Qdrant Vector DB
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=learning_materials

# Firebase Credentials (Option A: Individual Variables - Recommended for Render)
