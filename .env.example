# ==========================================
# AcademicIQ Platform - Environment Variables
# ==========================================

# ------------------------------------------
# Backend (FastAPI) Configuration
# ------------------------------------------
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://personalized-learning-frontend.onrender.com

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Qdrant Vector DB
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=learning_materials

# Firebase Credentials (Option A: Individual Variables - Recommended for Render)
FIREBASE_PROJECT_ID=personalized-learning-a2477
FIREBASE_CLIENT_EMAIL=your-service-account@personalized-learning-a2477.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Credentials (Option B: Full Service Account JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=kyp1f9pe
CLOUDINARY_API_KEY=592981562849528
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_URL=cloudinary://592981562849528:your_cloudinary_api_secret_here@kyp1f9pe

# Security
ADMIN_SETUP_SECRET=academic-admin-secret-2026

# ------------------------------------------
# Frontend (Next.js) Configuration
# ------------------------------------------
NEXT_PUBLIC_API_URL=https://personalized-learning-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://personalized-learning-backend.onrender.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=personalized-learning-a2477.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=personalized-learning-a2477
